# Só é necessário para rodar no seu PC (npm run dev). No Render, estas variáveis vão na aba Environment do serviço.

# Token do bot: Discord Developer Portal -> seu app -> Bot -> Reset Token  (SECRETO)
DISCORD_TOKEN=

# Onde guardar quem vinculou qual conta e os painéis ao vivo (use o MESMO Redis do site).
# No Render o disco apaga a cada reinício, então isto é obrigatório lá.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Endereço do site (de onde vem o Live Ranked)
GRACEHALLA_URL=https://grace-halla.vercel.app
DAIR_API_BASE=https://api.dair.gg

# (opcional) ID do seu servidor: os comandos aparecem na hora. Sem isso, são globais (podem levar até 1 h na 1ª vez).
# DISCORD_GUILD_ID=
# (opcional, só para npm run deploy no PC) DISCORD_CLIENT_ID=
